# Blokir akses langsung ke semua file PHP KECUALI ai-insight.php dan data.php
<FilesMatch "^(?!(ai-insight\.php|data\.php)$).+\.php$">
    Require all denied
</FilesMatch>

# Block directory listing
Options -Indexes

# Set API key & Spreadsheet ID via environment variable
SetEnv OPENAI_API_KEY "..."
SetEnv SHEET_ID_LAANGKE "1FZZpyF6lG6cvPUu-i8gn9WcOMhExN_OG"
SetEnv SHEET_ID_LAKONEA "1jjnaeoxpSVPY3Rl1aMbFlkzsgDo832h8"
SetEnv SHEET_ID_MALALANDA "1_eRZFFXR67qRl7nzZ8lSe7d5Tp88xnEe"
SetEnv SHEET_ID_POPUP "1DlOHH6M3QiEot8Jv_ik-XUIpCx9Q-BzJJVo3H8UB6pI"

# Security Headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<IfModule mod_php.c>
    php_value post_max_size 2M
    php_value upload_max_filesize 0
    php_flag file_uploads off
</IfModule>