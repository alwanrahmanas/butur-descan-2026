# ============================================
# Konfigurasi Environment - Desa Cantik API
# ============================================
# 
# CARA PENGGUNAAN:
# 
# 1. LOKAL (Laragon):
#    - Tambahkan SetEnv di file httpd-vhosts.conf Laragon:
#      SetEnv OPENAI_API_KEY "sk-..."
#    - Atau tambahkan di file api/.htaccess:
#      SetEnv OPENAI_API_KEY "sk-..."
#
# 2. HOSTING (cPanel Rumahweb):
#    - Buka cPanel > Environment Variables, atau
#    - Tambahkan di file .htaccess folder api/:
#      SetEnv OPENAI_API_KEY "sk-..."
#
# JANGAN PERNAH menyimpan API key langsung di config.php atau file yang di-commit ke Git!
# ============================================

OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
